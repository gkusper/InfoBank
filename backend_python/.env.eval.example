# Copy to .env.eval for local evaluation runs, or set these values in the
# backend process environment. Do not commit .env.eval.
#
# Keep OPENAI_API_KEY in the process environment. Anthropic LLM smoke tests
# also require ANTHROPIC_API_KEY, but still use OPENAI_API_KEY for compatible
# query/document embeddings.

DATABASE_URL=mysql+pymysql://infobank:<password>@127.0.0.1:3307/infobank_eval?charset=utf8mb4
CHROMA_PERSIST_DIR=./chroma_eval
AI_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
