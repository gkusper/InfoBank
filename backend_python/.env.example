# InfoBank backend configuration.
# Copy this file to backend_python/.env and replace placeholder values as needed.

# Mandatory for startup: SQLAlchemy database URL.
# The docker-compose.yml service exposes MariaDB on localhost port 3307.
DATABASE_URL=mysql+pymysql://infobank:infobank_dev_password@127.0.0.1:3307/infobank_db?charset=utf8mb4

# Mandatory for startup: local JWT signing secret.
# Use a long random value for any shared or deployed environment.
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_ISSUER=infobank-api
JWT_AUDIENCE=infobank-frontend

# Comma-separated exact browser origins. Wildcard origins are rejected while
# credentialed requests are enabled.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# Optional for startup, required for OpenAI LLM mode and for OpenAI-backed
# document/query embeddings. Claude LLM mode normally still needs this key for
# query embeddings because the existing Chroma vectors use OpenAI embeddings.
OPENAI_API_KEY=

# Optional for startup, required only when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# LLM provider and models. Relative runtime paths are resolved from
# backend_python, independently of the terminal's current directory.
AI_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=512
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_RETRIES=1

# Legacy OpenAI overrides retained for older local environments. Leave
# AI_KEYWORD_MODEL empty in Anthropic mode so ANTHROPIC_MODEL is used for
# query-time keyword selection.
AI_GENERATION_MODEL=
AI_KEYWORD_MODEL=

# Embeddings remain OpenAI-compatible in this branch. Do not switch this to
# anthropic; no reindexing is needed when changing only AI_PROVIDER.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_MODEL=
CHROMA_PERSIST_DIR=./chroma_data

# Optional only for OpenAI text-embedding-3 models when requesting a non-default
# supported vector size. Leave empty to use the model default.
AI_EMBEDDING_DIMENSIONS=

# Server-side routing feature flag. Both modes run after governance; this is
# intentionally not client-controllable.
INFOBANK_ROUTING_MODE=KEYWORD_ROUTING

# Optional durable uploaded-PDF storage. Defaults to backend_python/runtime/source_storage.
# Store this outside the repository for shared or deployed environments.
SOURCE_STORAGE_DIR=

# Maximum accepted PDF upload size in bytes (default: 25 MiB). Uploads must
# also use a .pdf filename, a PDF MIME type, and contain a valid PDF signature.
MAX_UPLOAD_BYTES=26214400

# Optional: Gmail OAuth connector. Required only for /api/connectors/gmail/auth-url and Gmail sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/connectors/gmail/callback

# Optional dedicated secrets for encrypted, expiring OAuth state and encrypted
# connector tokens. If omitted, domain-separated keys are derived from
# JWT_SECRET_KEY. Changing the effective token key requires reconnecting Gmail.
OAUTH_STATE_SECRET=
CONNECTOR_TOKEN_ENCRYPTION_KEY=

# Optional: public base URL used by connector callbacks.
APP_BASE_URL=http://127.0.0.1:8000
