    "evaluation_identity": {"type": "string", "minLength": 1},
    "query_text": {"type": "string", "minLength": 1},
    "declared_purpose": {"type": "string", "minLength": 1},
    "corpus_package_ref": {"type": "string", "minLength": 1},
    "policy_fixture_ref": {"type": "string", "minLength": 1},
    "runtime_parameters": {"type": "object"},
    "schema_version": {"const": "infobank-query-input-v1"}
