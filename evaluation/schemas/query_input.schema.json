{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/infobank/query-input-v1.schema.json",
  "title": "InfoBank QueryInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "evaluation_identity",
    "query_text",
    "declared_purpose",
    "corpus_package_ref",
